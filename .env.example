# Kopiere nach `.env` und fülle aus. NICHT einchecken (.env ist in .gitignore).
# In der Shell laden mit:  set -a; source .env; set +a

# --- E-Mail (SMTP) ---
# Gmail: App-Passwort erstellen unter https://myaccount.google.com/apppasswords
SMTP_USERNAME=deine.adresse@gmail.com
SMTP_PASSWORD=dein-app-passwort

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
